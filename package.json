{
  "name": "fontext",
  "version": "1.11.0",
  "description": "Script for extracting glyphes by ligatures from font and creating new minimized fonts with them",
  "keywords": [
    "font",
    "ligatures",
    "minimizer",
    "assets",
    "svgFont",
    "ttf",
    "woff2",
    "woff",
    "eot",
    "convertor",
    "harfbuzz"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a3mitskevich/fontext.git"
  },
  "homepage": "https://github.com/a3mitskevich/fontext",
  "author": "Aleksandr Mitskevich johndeathsmell@gmail.com",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "fontext": "dist/cli.js"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local": "TEST_TARGET=local npm run test",
    "test:dist": "TEST_TARGET=dist npm run test",
    "build": "tsdown",
    "lint:pkg": "publint --strict && attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "lint": "oxlint src/ test/ scripts/ e2e/ --tsconfig tsconfig.json --deny-warnings",
    "lint:fix": "oxlint src/ test/ scripts/ e2e/ --tsconfig tsconfig.json --fix",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.config.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "format": "oxfmt --write src/ test/ scripts/ e2e/ *.ts",
    "format:check": "oxfmt --check src/ test/ scripts/ e2e/ *.ts",
    "cli:help": "node dist/cli.js --help",
    "cli:init": "node dist/cli.js --init",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .gitmessage",
    "e2e:generate": "node e2e/generate.mjs",
    "e2e:build": "npm run build && npm run e2e:generate && vite build --config e2e/vite.config.ts",
    "e2e:serve": "vite preview --config e2e/vite.config.ts",
    "test:e2e:chrome": "npm run e2e:build && playwright test --project=chrome",
    "test:e2e:firefox": "npm run e2e:build && playwright test --project=firefox",
    "test:e2e:safari": "npm run e2e:build && node e2e/run-safari.mjs",
    "test:e2e:manual": "npm run e2e:build && npm run e2e:serve"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^25.9.8",
    "@types/subset-font": "^2.3.0",
    "@types/svg2ttf": "^5.0.3",
    "@types/ttf2eot": "^2.0.2",
    "@types/ttf2woff": "^2.0.4",
    "@types/wawoff2": "^1.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "harfbuzzjs": "^1.6.2",
    "subset-font": "^2.9.0",
    "svg2ttf": "6.1.0",
    "ttf2eot": "3.1.0",
    "ttf2woff": "3.0.0",
    "wawoff2": "^2.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
